    author: Jacob McSwain
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    copyright: 2026 Jacob McSwain, GPL-3.0-or-later
    description: Play a DMR recording of 8-bit I/Q in a loop and show what the dmrgo receiver decodes
    generate_options: qt_gui
    id: dmrgo_rx_gui
    output_language: python
    placement: (0,0)
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    title: dmrgo RX live view
    window_size: (1000,1000)
    qt_qss_theme: ''
    realtime_scheduling: ''
    thread_safe_setters: ''
    max_nouts: '0'
    hier_block_src_path: '.:'
    gen_cmake: 'On'
    gen_linking: dynamic
    cmake_opt: ''
    comment: ''
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
