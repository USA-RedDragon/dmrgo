- name: epy_block_0
  id: epy_block
  parameters:
    idle_every: '50'
    _source_code: |
      """DMR call display: shows the calls and bursts that the dmrgo receiver decodes."""

      import time

      import pmt
      from gnuradio import gr
      from PyQt5 import QtCore, QtGui, QtWidgets

      DATA_TYPES = ["PI Header", "Voice LC Header", "Terminator with LC", "CSBK", "MBC Header",
                    "MBC Continuation", "Data Header", "Rate 1/2 Data", "Rate 3/4 Data", "Idle", "Rate 1 Data"]


      class _Relay(QtCore.QObject):
          line = QtCore.pyqtSignal(str)
          call = QtCore.pyqtSignal(int, str)


      class blk(gr.basic_block):
          """DMR Call Display

          Takes the bursts PDUs of the dmrgo receiver and shows the call on each
          timeslot and a log of the bursts in a Qt widget. Add widget() to the
          layout of the flowgraph."""

          def __init__(self, idle_every=50):
              gr.basic_block.__init__(self, name="DMR Call Display", in_sig=None, out_sig=None)
              self.idle_every = idle_every
              self.message_port_register_in(pmt.intern("bursts"))
              self.set_msg_handler(pmt.intern("bursts"), self._handle)
              self._relay = _Relay()
              self._widget = None
              self._idle = 0
              self._count = 0

          def widget(self):
              if self._widget is not None:
                  return self._widget
              w = QtWidgets.QWidget()
              lay = QtWidgets.QVBoxLayout(w)
              title = QtWidgets.QLabel("dmrgo decoded calls")
              title.setStyleSheet("font-size: 16pt; font-weight: bold;")
              lay.addWidget(title)
              self._calls = {}
              row = QtWidgets.QHBoxLayout()
              for ts in (1, 2):
                  lab = QtWidgets.QLabel(f"TS{ts}: no call")
                  lab.setStyleSheet("font-family: monospace; font-size: 13pt; padding: 6px;"
                                    "border: 1px solid #888; background: #f4f4f4;")
                  lab.setMinimumHeight(70)
                  row.addWidget(lab)
                  self._calls[ts] = lab
              lay.addLayout(row)
              log = QtWidgets.QPlainTextEdit()
              log.setReadOnly(True)
              log.setMaximumBlockCount(500)
              log.setFont(QtGui.QFont("monospace", 10))
              lay.addWidget(log)
              self._relay.line.connect(log.appendPlainText)
              self._relay.call.connect(lambda ts, s: self._calls[ts].setText(s) if ts in self._calls else None)
              self._widget = w
              return w

          def _handle(self, msg):
              meta = pmt.car(msg)

              def get(k, d=None):
                  v = pmt.dict_ref(meta, pmt.intern(k), pmt.PMT_NIL)
                  if pmt.is_null(v):
                      return d
                  if pmt.is_symbol(v):
                      return pmt.symbol_to_string(v)
                  if pmt.is_bool(v):
                      return pmt.to_bool(v)
                  if pmt.is_real(v):
                      return pmt.to_double(v)
                  return pmt.to_long(v)

              self._count += 1
              kind = get("kind", "unknown")
              dt = get("data_type", -1)
              if kind == "data" and dt == 9:
                  self._idle += 1
                  if self._idle % self.idle_every != 1:
                      return
              ts = get("timeslot", 0)
              cc = get("color_code", -1)
              src = get("src")
              dst = get("dst")
              pos = get("voice_pos", -1)
              if kind == "voice":
                  what = "Voice " + ("ABCDEF"[pos] if 0 <= pos < 6 else "?")
              elif kind == "data":
                  what = DATA_TYPES[dt] if 0 <= dt < len(DATA_TYPES) else f"data type {dt}"
                  if dt == 9:
                      what += f" (1 of {self.idle_every} shown)"
              else:
                  what = kind
              fec = "FEC bad" if get("fec_bad", False) else f"FEC ok, {get('fec_corrected', 0)} fixed"
              sd = get("sync_distance", -1)
              ccs = f"CC{cc}" if cc >= 0 else "CC-"
              line = f"{get('seconds', 0.0):8.3f} s  TS{ts}  {ccs:<4} {what:<30} sync {sd if sd >= 0 else '-':<2} {fec}"
              if src is not None:
                  group = "TG" if get("group", False) else "ID"
                  line += f"  {src} > {group} {dst}"
                  self._relay.call.emit(ts, f"TS{ts}  {ccs}  {time.strftime('%H:%M:%S')}\nsrc {src}  ->  {group} {dst}\n"
                                            f"FID 0x{get('fid', 0):02X}  {what}")
              self._relay.line.emit(line)
  states:
    coordinate:
    - 780
    - 540
    rotation: 0
    state: enabled
- name: snippet_0
